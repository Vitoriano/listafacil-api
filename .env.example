DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
REDIS_URL=redis://localhost:6380

JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=30

PORT=3000
NODE_ENV=development

# =============================================================================
# Produção — GitHub Actions (GHCR) + Dokploy
# =============================================================================
# Pipeline: push em `production` → migrate → build/push GHCR → webhook Dokploy
# Workflow: .github/workflows/production.yml | Stack: deploy/dokploy/docker-compose.yml
# Imagem: ghcr.io/vitoriano/listafacil-api (tags :latest e :<sha>)
#
# --- GitHub Actions (Settings → Secrets → Actions) ---
# DATABASE_URL           → job migrate (Postgres de prod no Neon)
# DOKPLOY_WEBHOOK_URL    → redeploy do stack no Dokploy (opcional)
#
# --- Dokploy (Env do stack — NÃO commitar .env de prod) ---
# DATABASE_URL                 obrigatório (URL pooled do Neon, com ?sslmode=require)
# JWT_PRIVATE_KEY_B64          obrigatório (PEM em base64, uma linha — ver DEPLOY.md)
# JWT_PUBLIC_KEY_B64           obrigatório (PEM em base64, uma linha)
# JWT_ACCESS_EXPIRATION        opcional (default 15m)
# JWT_REFRESH_EXPIRATION_DAYS  opcional (default 30)
# IMAGE_TAG                    opcional (default latest)
#
# Domínio na UI do Dokploy → serviço `api`, porta 3000.
